        { "type": "fill", "selector": "input[type='email']", "value": "__DAILY_TOUR_LOGIN_EMAIL__" },
        { "type": "fill", "selector": "input[type='password']", "value": "__DAILY_TOUR_LOGIN_PASSWORD__" },
        { "type": "click", "selector": "button[type='submit']" },
        { "type": "wait", "ms": 2000 }
      ]
    },
    {
      "letter": "B",
      "caption": "Finance overview � overdue total visible without exporting",
      "path": "/finance",
      "actions": [{ "type": "wait", "ms": 1200 }]
    },
    {
      "letter": "C",
      "caption": "Invoice list � filter to overdue only",
      "path": "/finance/invoices",
      "actions": [
        { "type": "wait", "ms": 800 },
        { "type": "click", "selector": "[data-testid='filter-overdue']" },
