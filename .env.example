# App URL (used for email confirmation & password reset links; set in production)
# Local: NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (canonical www — Vercel redirects apex → www):
# NEXT_PUBLIC_APP_URL=https://www.shuleos.app

# Supabase - AMC project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://ooheotsnplfrpgblrnot.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Dashboard > Authentication > URL Configuration:
# - Site URL: https://www.shuleos.app
# - Redirect URLs:
#   http://localhost:3000/auth/callback
#   https://www.shuleos.app/auth/callback
#   https://www.shuleos.app/auth/callback?intent=register
#   https://www.shuleos.app/**
#   (optional) https://shuleos.app/** for apex

# Google OAuth (Supabase Auth > Providers > Google, and Google Cloud Console)
# Authorized redirect URI in Google: https://ooheotsnplfrpgblrnot.supabase.co/auth/v1/callback
# Must match NEXT_PUBLIC_SUPABASE_URL (AMS project ref: ooheotsnplfrpgblrnot).
# Add https://www.shuleos.app/auth/callback (and localhost) under Supabase Auth > URL Configuration > Redirect URLs
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Service role key (server-only; must match the project above)
# Local dev: put this in .env.local only. Next.js does NOT load .env.vercel.* files.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database URL (for migrations - get from Supabase Dashboard > Settings > Database > Connection string > URI)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or set SUPABASE_DB_PASSWORD instead (region defaults to eu-central-1; override with SUPABASE_DB_REGION)

# Payment webhook secret (for Paystack, Flutterwave, etc. — school fee payments)
# PAYMENT_WEBHOOK_SECRET=

# Stripe SaaS billing (schools pay ShuleOS for platform access)
# Create a Product + recurring Price of exactly $350 USD in Stripe Dashboard, then set:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...          # must be the $350 plan (fixed; not per-school)
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: /api/webhooks/stripe
# Optional free trial days on Checkout:
# STRIPE_TRIAL_DAYS=14

# Resend (transactional email: admissions, fee reminders, etc.)
# Create a key at https://resend.com/api-keys and verify a domain at https://resend.com/domains
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=ShuleOS <noreply@shuleos.app>
#
# Auth emails (invite / signup confirm / password reset) still come from Supabase Auth.
# Point Supabase SMTP at Resend so those go through Resend too:
#   Supabase → Authentication → Email → SMTP Settings
#   Host: smtp.resend.com | Port: 465 | User: resend | Password: <RESEND_API_KEY>
# Or use Resend → Settings → Integrations → Connect to Supabase.
# Docs: https://resend.com/docs/send-with-supabase-smtp

# WhatsApp via Twilio (for mass outreach and fee reminders)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Phone / WhatsApp OTP login (Twilio Verify — separate from fee-reminder Messaging API)
# Supabase dashboard + config.toml want the Verify Service SID (VA...), not the Messaging Service (MG...).
# MG... is only for linking WhatsApp Sender inside Twilio Verify → WhatsApp tab.
# See docs/PHONE_WHATSAPP_AUTH.md
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_MESSAGE_SERVICE_SID=VA...  # alias used in supabase/config.toml env name
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your_auth_token_here

# Cron job secret (protects /api/cron/fee-reminders and /api/cron/class-reminders)
# CRON_SECRET=your_random_secret_here

# Optional: timezone for class-time alarms (default Africa/Kinshasa)
# CLASS_REMINDER_TIMEZONE=Africa/Kinshasa

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:you@yourschool.com

# School ID (used in campaign pages; set to your school's UUID)
# NEXT_PUBLIC_SCHOOL_ID=your_school_uuid_here

# Optional: Sentry (for error monitoring)
# SENTRY_DSN=your_sentry_dsn
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_ORG=your_org_slug
# SENTRY_PROJECT=your_project_slug
